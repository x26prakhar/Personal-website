---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const sortedPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title="Prakhar Singh">
    <!-- Hero Section -->
    <section class="hero hero-full">
        <div class="container">
            <h1 class="hero-greeting">My name is Prakhar</h1>
            <img src="/images/prakhar.jpg" alt="Prakhar Singh" class="hero-photo" width="800" height="1200" />
            <div class="hero-icons">
                <a href="mailto:prakhar.lamp@gmail.com" aria-label="Email">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="26" height="26"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                </a>
                <a href="https://www.linkedin.com/in/prakharsingh96/" target="_blank" rel="noopener" aria-label="LinkedIn">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="26" height="26"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10v7"/><path d="M8 7v.01"/><path d="M12 17v-7"/><path d="M16 17v-4a2 2 0 0 0-4 0"/></svg>
                </a>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section class="about">
        <div class="container">
            <p>
                I am currently pursuing the MBA (PGPX) at IIM Ahmedabad.
            </p>
            <p>
                Previously, I worked in venture capital at <a href="https://enzia.vc" target="_blank" rel="noopener">Enzia Ventures</a> and <a href="https://www.yunussb.com/" target="_blank" rel="noopener">Yunus Social Business</a>, investing in founders building businesses in education, healthcare, and sustainable livelihoods. I was drawn to finding promising businesses, understanding the people behind them, and backing their growth with capital.
            </p>
            <p>
                Before venture capital, I was part of the early team building <a href="https://www.indianphilanthropy.org/" target="_blank" rel="noopener">Accelerate Indian Philanthropy</a> at <a href="https://www.theconvergencefoundation.org/" target="_blank" rel="noopener">The Convergence Foundation</a>, helping mobilise philanthropic capital alongside leading Indian and global philanthropists.
            </p>
            <p>
                My experience spans investing and capital mobilisation, grounded in an earlier career in economics and public policy. I am curious about emerging businesses, technology, and what it takes to turn a founder’s ambition into an enduring company.
            </p>
            <p>
                I am very curious. I read a lot, write often, and enjoy exploring ideas across economics, policy, and technology. I am drawn to conversations that challenge how I think, and I like going deep on questions that matter.
            </p>

            <p class="contact-links">
                <a href="https://www.linkedin.com/in/prakharsingh96/" target="_blank" rel="noopener">LinkedIn</a>
                <span class="contact-sep">·</span>
                <a href="mailto:prakhar.lamp@gmail.com">prakhar.lamp@gmail.com</a>
                <span class="contact-sep">·</span>
                <a href="https://www.instagram.com/prakhar.vc/" target="_blank" rel="noopener">Instagram</a>
                <span class="contact-sep">·</span>
                <a href="https://github.com/x26prakhar" target="_blank" rel="noopener">GitHub</a>
            </p>

            <div class="wa-callout-wrap">
              <a href="https://chat.whatsapp.com/GIkUd2Zd5425GzfRpmHyHR" target="_blank" rel="noopener noreferrer" class="wa-callout">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                <span>I run a WhatsApp community on AI for non-techies.</span>
                <span class="wa-members">500+ members</span>
                <span class="wa-join">Join →</span>
              </a>
            </div>

            <div class="wa-callout-wrap vc-callout-wrap">
              <a href="https://thevcconnect.in/" target="_blank" rel="noopener noreferrer" class="wa-callout vc-callout">
