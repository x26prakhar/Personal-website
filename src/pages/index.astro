<style>
  .contact-links {
    font-size: 0.9rem !important;
  }

  .contact-sep {
    color: var(--color-text-secondary);
    margin: 0 10px;
  }

  /* WhatsApp callout */
  .wa-callout-wrap {
    display: flex;
    justify-content: flex-start;
    margin-top: 0;
  }

  .wa-callout {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #e8f5e2;
    border: 1px solid #c3ddb8;
    border-radius: 4px;
    padding: 13px 22px;
    font-size: 0.85rem;
    color: #2d5a20;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .wa-callout:hover {
    background: #ddf0d4;
    text-decoration: none;
  }

  .wa-members {
    background: #c3ddb8;
    color: #2d5a20;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 20px;
  }

  .wa-join {
    font-weight: 600;
    margin-left: 4px;
  }

  /* VC Connect callout */
  .vc-callout-wrap {
    margin-top: 12px;
  }

  .vc-callout {
    background: #e6edf7;
    border-color: #bccde6;
    color: #1f3a66;
  }

  .vc-callout:hover {
    background: #dbe5f3;
  }

  .vc-badge {
    background: #bccde6;
    color: #1f3a66;
  }

  /* First screen: heading, photo and contact icons only */
  .hero-full {
    min-height: calc(100vh - 96px);
    min-height: calc(100svh - 96px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 24px 0 48px;
  }

  .hero-photo {
    display: block;
    height: min(58vh, 540px);
    height: min(58svh, 540px);
    width: auto;
    max-width: 100%;
    margin: 24px auto 0;
  }

  .hero-icons {
    display: flex;
    justify-content: center;
    gap: 36px;
    margin-top: 32px;
  }

  .hero-icons a {
    color: #9c4a2f;
    display: inline-flex;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .hero-icons a:hover {
    color: #7a3520;
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .hero-full {
      min-height: calc(100svh - 110px);
      padding: 16px 0 32px;
    }

    .hero-photo {
      height: min(56svh, 117vw);
      margin-top: 16px;
    }

    .hero-icons {
      margin-top: 24px;
    }
  }

  @media (max-width: 560px) {
    .wa-callout {
      flex-wrap: wrap;
      gap: 8px;
    }
  }
</style>
